{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "docs/SEO_INTEGRATION_EXAMPLES.tsx",
    "docs/SSR_SETUP_EXAMPLE.tsx",
    "docs/MICROFORMATOS_EJEMPLOS.tsx",
    "MIGRATION_HELMET.ts",
    "PERSISTENCE_HTTPS_FAVICONS.ts",
    "TIPS_BEST_PRACTICES.ts"
  ]
}