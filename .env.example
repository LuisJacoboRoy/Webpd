# Configuración de Desarrollo - Copiar a .env.local

# API y URLs
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3000

# Server-only variables for Vercel Functions (never use VITE_ prefixes)
# WhatsApp webhook database (service role key must be added privately)
SUPABASEW_SUPABASE_URL=https://your-project.supabase.co
SUPABASEW_SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
WHATSAPP_VERIFY_TOKEN=your_private_webhook_verification_token
META_APP_SECRET=your_private_meta_app_secret
# Legacy names retained for existing server functions
STORAGE_SUPABASE_URL=https://your-project.supabase.co
STORAGE_SUPABASE_SERVICE_KEY=your_server_only_service_role_key
GEMINI_API_KEY=your_server_only_gemini_api_key
keygoogleimg=your_server_only_gemini_image_api_key
ADMIN_SESSION_SECRET=generate_a_random_secret_at_least_32_characters
ADMIN_INITIAL_SETUP_SECRET=generate_a_different_random_secret_at_least_32_characters
CRON_SECRET=your_cron_secret
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_server_only_page_access_token
META_GRAPH_API_VERSION=v27.0

# Modo HTTPS en desarrollo (requiere certificados en ./certs/)
HTTPS=false

# Environment
MODE=development

# Notas:
# - Rename .env.example a .env.local
# - NO incluir en git (agregar a .gitignore)
# - En producción, usar variables de Netlify/Vercel
# - Para HTTPS en desarrollo, generar certs con:
#   openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem -out certs/cert.pem -days 365 -nodes
