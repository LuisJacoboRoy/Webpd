# Configuración de Desarrollo - Copiar a .env.local

# API y URLs
VITE_API_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3000

# Server-only variables for Vercel Functions
STORAGE_SUPABASE_URL=https://your-project.supabase.co
STORAGE_SUPABASE_SERVICE_KEY=your_server_only_service_key
GEMINI_API_KEY=your_server_only_gemini_api_key
keygoogleimg=your_server_only_gemini_image_api_key
ADMIN_SESSION_SECRET=generate_a_random_secret_at_least_32_characters
ADMIN_INITIAL_SETUP_SECRET=generate_a_different_random_secret_at_least_32_characters
CRON_SECRET=your_cron_secret

# Modo HTTPS en desarrollo (requiere certificados en ./certs/)
HTTPS=false

# Environment
MODE=development

# Notas:
# - Rename .env.example a .env.local
# - NO incluir en git (agregar a .gitignore)
# - En producción, usar variables de Netlify/Vercel
# - Para HTTPS en desarrollo, generar certs con:
#   openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem -out certs/cert.pem -days 365 -nodes
